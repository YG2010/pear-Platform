# Template only — real values live in Vercel → Project → Settings → Environment Variables.
# Generate the real file with:  npm run pull-env   (writes .env.local, which is gitignored)
#
# Without DOCS_PASSCODE set, api/get-docs.js fails closed with 500 server_misconfigured
# (see api/get-docs.js:334) — that is deliberate, a missing var must never mean "let everyone in".
DOCS_PASSCODE=choose-a-local-dev-code

# Optional. Overrides the origin allowlist in api/get-docs.js:109.
# Only consulted when the browser omits Sec-Fetch-Site, so it is rarely needed locally.
# ALLOWED_ORIGIN=http://localhost:3000
